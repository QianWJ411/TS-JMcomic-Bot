{
  "name": "ts-jmcomic-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TeamSpeak comic bot: downloads comics to PDF and writes them into the TS server files directory",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "selftest": "tsx scripts/selftest.ts"
  },
  "dependencies": {
    "@honeybbq/teamspeak-client": "^0.3.3",
    "express": "^4.21.2",
    "https-proxy-agent": "^7.0.6",
    "pdfkit": "^0.17.2",
    "sharp": "^0.34.0",
    "socks-proxy-agent": "^8.0.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^24.10.0",
    "@types/pdfkit": "^0.17.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
